# Root-level environment for `docker compose up` ONLY (Week 7, Phase 8).
#
# This is separate from backend/.env.example and frontend/.env.example,
# which remain for local (non-Docker) `npm run dev` and are unaffected by
# this file. Copy this file to `.env` in this same directory (already
# git-ignored by the root .gitignore) and fill in real values there —
# never edit this .example file with real secrets.

# --- PostgreSQL (the "db" service) ---
POSTGRES_DB=jobtrackr
POSTGRES_USER=jobtrackr
POSTGRES_PASSWORD=jobtrackr
# Host port Postgres is published on (container always uses 5432 internally).
POSTGRES_PORT=5432

# --- Backend ---
# Host port the backend is published on (used both by the container's own
# PORT and by the frontend's default VITE_API_BASE_URL below).
BACKEND_PORT=3000

# Which AI provider the Resume Reviewer / Follow-up Agent use: groq |
# openrouter. Defaults to "groq" if unset. Only the matching key below
# needs to be set — the app and all CRUD functionality work fine with
# neither key configured (AI endpoints fail cleanly with 503 instead).
AI_PROVIDER=groq

# Put your real key(s) only in your local, git-ignored .env — never here,
# never in docker-compose.yml, never in any Dockerfile.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Frontend ---
# Host port the frontend (nginx) is published on.
FRONTEND_PORT=5173
# Backend URL the BROWSER will call — must be the backend's published host
# port above, not the internal Docker service name "backend".
VITE_API_BASE_URL=http://localhost:3000
