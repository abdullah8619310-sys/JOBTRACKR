NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma. Replace USER/PASSWORD/DB name
# with your local Postgres credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jobtrackr?schema=public"

# Which AI provider the Resume Reviewer / Follow-up Agent use. One of:
# groq | openrouter. Defaults to "groq" if unset. Only the key matching
# whichever provider is selected needs to be set — the app and all CRUD
# functionality work fine with neither key configured.
# AI_PROVIDER=groq

# Required only if AI_PROVIDER=groq (or left unset, since that's the default).
# GROQ_API_KEY=your-groq-api-key

# Required only if AI_PROVIDER=openrouter.
# OPENROUTER_API_KEY=your-openrouter-api-key
